      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 400],
      "id": "lead-found",
      "name": "Lead Found?"
    },
    {
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"anthropic/claude-3.5-sonnet\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this SMS response from a property owner we contacted about buying their house.\\n\\nTheir Response: {{ $('Parse Twilio Data').item.json.message }}\\n\\nProperty Info:\\n- Address: {{ $('Find Lead (Response)').item.json.fields.Address }}\\n- City: {{ $('Find Lead (Response)').item.json.fields.City }}\\n- AI Score: {{ $('Find Lead (Response)').item.json.fields['AI Score'] }}\\n\\nClassify the response and determine next steps.\\n\\nReturn ONLY valid JSON:\\n{\\n  \\\"sentiment\\\": \\\"positive|neutral|negative\\\",\\n  \\\"interest_level\\\": \\\"HOT|Warm|Cold\\\",\\n  \\\"intent\\\": \\\"wants_call|wants_info|asking_price|not_interested|spam|unclear\\\",\\n  \\\"suggested_action\\\": \\\"call_immediately|send_more_info|follow_up_later|remove_from_list\\\",\\n  \\\"reply_suggestion\\\": \\\"Brief suggested SMS reply if appropriate\\\",\\n  \\\"summary\\\": \\\"1-sentence summary of their response\\\"\\n}\"\n    }\n  ],\n  \"max_tokens\": 400,\n  \"temperature\": 0.3\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 360],
      "id": "analyze-response",
      "name": "AI Analyze Response",
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-auth",
          "name": "OpenRouter"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI analysis\nconst aiResponse = $input.first().json;\nconst lead = $('Find Lead (Response)').item.json;\nconst smsData = $('Parse Twilio Data').item.json;\n\nlet analysis = {\n  sentiment: 'neutral',\n  interest_level: 'Warm',\n  intent: 'unclear',\n  suggested_action: 'follow_up_later',\n  reply_suggestion: '',\n  summary: 'Response received'\n};\n\ntry {\n  const content = aiResponse.choices[0].message.content;\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    analysis = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Use defaults\n}\n\nreturn [{\n  json: {\n    lead: lead,\n    smsData: smsData,\n    analysis: analysis\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 360],
      "id": "parse-analysis",
      "name": "Parse Analysis"
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
