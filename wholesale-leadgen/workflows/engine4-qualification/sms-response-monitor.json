              "fieldValue": "=SMS Opt-out received {{ $now.toISODate() }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1120, 200],
      "id": "mark-opt-out",
      "name": "Mark SMS Opt-Out",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
