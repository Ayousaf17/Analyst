{
  "name": "SMS Response Monitor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "twilio-sms-webhook",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "id": "twilio-webhook",
      "name": "Twilio SMS Webhook",
      "webhookId": "sms-response-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Parse Twilio webhook data\nconst body = $input.first().json.body;\n\n// Twilio sends form-encoded data\nconst from = body.From || '';\nconst to = body.To || '';\nconst message = body.Body || '';\nconst messageSid = body.MessageSid || '';\n\n// Normalize phone number (remove +1 prefix for lookup)\nconst normalizedPhone = from.replace(/^\\+1/, '').replace(/\\D/g, '');\n\nreturn [{\n  json: {\n    from: from,\n    to: to,\n    message: message,\n    messageSid: messageSid,\n    normalizedPhone: normalizedPhone,\n    isOptOut: /^(stop|unsubscribe|cancel|quit|end)$/i.test(message.trim())\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "parse-webhook",
      "name": "Parse Twilio Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-opt-out",
              "leftValue": "={{ $json.isOptOut }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300],
      "id": "check-opt-out",
      "name": "Is Opt-Out?"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "filterByFormula": "=SEARCH('{{ $('Parse Twilio Data').item.json.normalizedPhone }}', SUBSTITUTE(SUBSTITUTE({Phone}, '-', ''), ' ', ''))"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [900, 200],
      "id": "find-lead-optout",
      "name": "Find Lead (Opt-Out)",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
