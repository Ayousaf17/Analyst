    {
      "parameters": {
        "channel": "#hot-leads",
        "text": "=:fire: *HOT SMS RESPONSE!*\n\n*Property:* {{ $('Parse Analysis').item.json.lead.fields.Address }}, {{ $('Parse Analysis').item.json.lead.fields.City }}\n*Owner:* {{ $('Parse Analysis').item.json.lead.fields['Owner Name'] || 'Unknown' }}\n*Phone:* {{ $('Parse Analysis').item.json.lead.fields.Phone }}\n\n*Their Message:*\n> {{ $('Parse Analysis').item.json.smsData.message }}\n\n*AI Analysis:*\n- Intent: {{ $('Parse Analysis').item.json.analysis.intent }}\n- Suggested Action: {{ $('Parse Analysis').item.json.analysis.suggested_action }}\n\n*Suggested Reply:*\n{{ $('Parse Analysis').item.json.analysis.reply_suggestion }}\n\n:phone: *CALL NOW!*",
        "otherOptions": {}
      },
