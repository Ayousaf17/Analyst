            },
            {
              "fieldName": "AI Analysis",
              "fieldValue": "={{ JSON.stringify($json.analysis) }}"
            },
            {
              "fieldName": "Notes",
              "fieldValue": "={{ $json.analysis.summary }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1780, 360],
