            },
            {
              "fieldName": "AI Analysis",
              "fieldValue": "={{ JSON.stringify($('Parse AI Response').item.json.ai_legitimacy) }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [2880, 180],
