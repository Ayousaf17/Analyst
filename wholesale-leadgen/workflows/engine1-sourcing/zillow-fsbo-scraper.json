{
  "name": "Zillow FSBO Scraper (Apify)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "id": "schedule-daily",
      "name": "Daily 8 AM"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "filterByFormula": "={Key} = 'target_cities'"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "get-target-cities",
      "name": "Get Target Cities",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse target cities from Airtable settings\nconst settings = $input.first()?.json?.fields;\nlet cities = ['Austin, TX', 'San Antonio, TX', 'Houston, TX']; // defaults\n\nif (settings?.Value) {\n  try {\n    cities = JSON.parse(settings.Value);\n  } catch (e) {\n    cities = settings.Value.split(',').map(c => c.trim());\n  }\n}\n\n// Format for Apify: \"City, State\"\nreturn [{ json: { locations: cities } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "parse-cities",
      "name": "Parse Cities"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/petr_cermak~zillow-api-scraper/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchType\": \"sale\",\n  \"listingType\": \"fsbo\",\n  \"location\": {{ JSON.stringify($json.locations) }},\n  \"maxItems\": 100,\n  \"proxy\": {\n    \"useApifyProxy\": true,\n    \"apifyProxyGroups\": [\"RESIDENTIAL\"]\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "id": "run-apify-actor",
      "name": "Run Apify Zillow Actor",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract the run ID from Apify response\nconst response = $input.first().json;\nconst runId = response.body?.data?.id || response.data?.id;\n\nif (!runId) {\n  throw new Error('Failed to start Apify actor - no run ID returned');\n}\n\nreturn [{ json: { runId: runId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "id": "extract-run-id",
      "name": "Extract Run ID"
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "minutes"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 300],
      "id": "wait-for-actor",
      "name": "Wait for Actor (3 min)",
      "webhookId": "zillow-apify-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/actor-runs/{{ $('Extract Run ID').item.json.runId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "id": "check-run-status",
      "name": "Check Run Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-running",
              "leftValue": "={{ $json.data?.status }}",
              "rightValue": "RUNNING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1780, 300],
      "id": "still-running",
      "name": "Still Running?"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "minutes"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2000, 240],
      "id": "wait-more",
      "name": "Wait 2 More Min",
      "webhookId": "zillow-wait-more"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/actor-runs/{{ $('Extract Run ID').item.json.runId }}/dataset/items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 380],
      "id": "get-results",
      "name": "Get Apify Results",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Apify results into our lead format\nconst results = $input.first().json;\n\n// Handle both array and object with items\nconst items = Array.isArray(results) ? results : (results.items || results.data || []);\n\nreturn items.map(item => ({\n  json: {\n    address: item.streetAddress || item.address || '',\n    city: item.city || '',\n    state: item.state || 'TX',\n    zip: item.zipcode || item.postalCode || '',\n    price: item.price || item.unformattedPrice || 0,\n    bedrooms: item.bedrooms || item.beds || 0,\n    bathrooms: item.bathrooms || item.baths || 0,\n    sqft: item.livingArea || item.sqft || 0,\n    lot_size: item.lotSize || '',\n    year_built: item.yearBuilt || '',\n    property_type: item.propertyType || item.homeType || '',\n    listing_url: item.url || item.detailUrl || '',\n    photo_url: item.imgSrc || (item.photos && item.photos[0]) || '',\n    description: item.description || '',\n    zestimate: item.zestimate || item.price || 0,\n    days_on_market: item.daysOnZillow || 0,\n    source: 'Zillow FSBO',\n    scraped_at: new Date().toISOString()\n  }\n})).filter(item => item.json.address);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 380],
      "id": "parse-results",
      "name": "Parse to Lead Format"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [2440, 380],
      "id": "loop-leads",
      "name": "Loop Through Leads"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "filterByFormula": "=AND({Address} = '{{ $json.address }}', {City} = '{{ $json.city }}')"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [2660, 340],
      "id": "check-duplicate",
      "name": "Check If Exists",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-new",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2880, 340],
      "id": "is-new-lead",
      "name": "Is New Lead?"
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "fields": {
          "fieldMapping": [
            {
              "fieldName": "Address",
              "fieldValue": "={{ $('Loop Through Leads').item.json.address }}"
            },
            {
              "fieldName": "City",
              "fieldValue": "={{ $('Loop Through Leads').item.json.city }}"
            },
            {
              "fieldName": "State",
              "fieldValue": "={{ $('Loop Through Leads').item.json.state }}"
            },
            {
              "fieldName": "ZIP",
              "fieldValue": "={{ $('Loop Through Leads').item.json.zip }}"
            },
            {
              "fieldName": "Asking Price",
              "fieldValue": "={{ $('Loop Through Leads').item.json.price }}"
            },
            {
              "fieldName": "Estimated Value",
              "fieldValue": "={{ $('Loop Through Leads').item.json.zestimate }}"
            },
            {
              "fieldName": "Beds",
              "fieldValue": "={{ $('Loop Through Leads').item.json.bedrooms }}"
            },
            {
              "fieldName": "Baths",
              "fieldValue": "={{ $('Loop Through Leads').item.json.bathrooms }}"
            },
            {
              "fieldName": "Sq Ft",
              "fieldValue": "={{ $('Loop Through Leads').item.json.sqft }}"
            },
            {
              "fieldName": "Property Type",
              "fieldValue": "={{ $('Loop Through Leads').item.json.property_type }}"
            },
            {
              "fieldName": "Source",
              "fieldValue": "Zillow FSBO"
            },
            {
              "fieldName": "Status",
              "fieldValue": "New"
            },
            {
              "fieldName": "Listing URL",
              "fieldValue": "={{ $('Loop Through Leads').item.json.listing_url }}"
            },
            {
              "fieldName": "Photo URL",
              "fieldValue": "={{ $('Loop Through Leads').item.json.photo_url }}"
            },
            {
              "fieldName": "Days on Market",
              "fieldValue": "={{ $('Loop Through Leads').item.json.days_on_market }}"
            },
            {
              "fieldName": "Priority",
              "fieldValue": "Medium"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [3100, 300],
      "id": "create-lead",
      "name": "Create Lead in Airtable",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3100, 420],
      "id": "skip-duplicate",
      "name": "Skip Duplicate"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3320, 380],
      "id": "done",
      "name": "Done"
    },
    {
      "parameters": {
        "content": "## Zillow FSBO Scraper (Apify)\n\n**Trigger:** Daily at 8 AM\n\n**Flow:**\n1. Get target cities from Airtable Settings\n2. Call Apify Zillow Actor with cities\n3. Wait for actor to complete (3-5 min)\n4. Get clean JSON results\n5. Check for duplicates\n6. Create new leads in Airtable\n\n**Benefits of Apify:**\n- 95%+ success rate (vs 70% DIY)\n- No proxy management\n- No HTML parsing\n- Apify maintains the scraper\n- Clean JSON output\n\n**Cost:** ~$0.50-1.00 per 100 listings",
        "height": 380,
        "width": 400,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 40],
      "id": "sticky-overview",
      "name": "Overview"
    }
  ],
