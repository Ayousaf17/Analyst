              "id": "is-new",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [3320, 340],
      "id": "is-new-lead",
      "name": "Is New Lead?"
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "fields": {
          "fieldMapping": [
            {
              "fieldName": "Address",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.address }}"
            },
            {
              "fieldName": "City",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.city }}"
            },
            {
              "fieldName": "State",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.state }}"
            },
            {
              "fieldName": "Asking Price",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.price }}"
            },
            {
              "fieldName": "Source",
              "fieldValue": "FB Marketplace"
            },
            {
              "fieldName": "Status",
              "fieldValue": "New"
            },
            {
              "fieldName": "Listing URL",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.listing_url }}"
            },
            {
              "fieldName": "Photo URL",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.photo_url }}"
            },
            {
              "fieldName": "Description",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.description }}"
            },
            {
              "fieldName": "Owner Name",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.seller_name }}"
            },
            {
              "fieldName": "Priority",
              "fieldValue": "={{ $('Parse AI Analysis').item.json.is_fsbo ? 'High' : 'Medium' }}"
            },
            {
              "fieldName": "Notes",
              "fieldValue": "=FB Marketplace listing. AI Confidence: {{ Math.round($('Parse AI Analysis').item.json.ai_confidence * 100) }}%. {{ $('Parse AI Analysis').item.json.ai_red_flags?.length > 0 ? 'Red flags: ' + $('Parse AI Analysis').item.json.ai_red_flags.join(', ') : '' }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [3540, 300],
      "id": "create-lead",
      "name": "Create Lead in Airtable",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3100, 480],
      "id": "skip-scam",
      "name": "Skip (Likely Scam)"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3540, 420],
      "id": "skip-duplicate",
      "name": "Skip Duplicate"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [3760, 380],
      "id": "done",
      "name": "Done"
    },
    {
      "parameters": {
        "content": "## FB Marketplace Scraper (Apify)\n\n**Trigger:** Every 6 hours\n\n**Why FB Marketplace:**\n- Many motivated sellers\n- Less competition than MLS\n- Often FSBO (For Sale By Owner)\n\n**Using Apify because:**\n- FB blocks direct scraping\n- Requires residential proxies\n- Complex authentication\n- ToS violations if DIY\n\n**AI Legitimacy Check:**\n- Filters out scams/spam\n- Verifies real property sales\n- Extracts addresses from descriptions\n- Confidence scoring\n\n**Cost:** ~$1-2 per 100 listings",
        "height": 400,
        "width": 400,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, 40],
      "id": "sticky-overview",
      "name": "Overview"
    }
  ],
