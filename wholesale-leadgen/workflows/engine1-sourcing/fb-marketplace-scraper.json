{
  "name": "FB Marketplace Scraper (Apify)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "id": "schedule-6h",
      "name": "Every 6 Hours"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "filterByFormula": "={Key} = 'target_cities'"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "get-cities",
      "name": "Get Target Cities",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse cities for FB Marketplace search\nconst settings = $input.first()?.json?.fields || {};\nlet cities = ['Austin, TX', 'San Antonio, TX', 'Houston, TX'];\n\nif (settings.Value) {\n  try {\n    cities = JSON.parse(settings.Value);\n  } catch (e) {\n    cities = settings.Value.split(',').map(c => c.trim());\n  }\n}\n\nreturn [{ json: { locations: cities } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "prepare-locations",
      "name": "Prepare Locations"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~facebook-marketplace-scraper/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchQuery\": \"house for sale by owner\",\n  \"location\": {{ JSON.stringify($json.locations) }},\n  \"maxItems\": 100,\n  \"categoryId\": \"propertyrentals\",\n  \"proxy\": {\n    \"useApifyProxy\": true,\n    \"apifyProxyGroups\": [\"RESIDENTIAL\"]\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "id": "run-apify-actor",
      "name": "Run Apify FB Actor",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract the run ID from Apify response\nconst response = $input.first().json;\nconst runId = response.body?.data?.id || response.data?.id;\n\nif (!runId) {\n  throw new Error('Failed to start Apify actor - no run ID returned');\n}\n\nreturn [{ json: { runId: runId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "id": "extract-run-id",
      "name": "Extract Run ID"
    },
    {
      "parameters": {
        "amount": 4,
        "unit": "minutes"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 300],
      "id": "wait-for-actor",
      "name": "Wait for Actor (4 min)",
      "webhookId": "fb-apify-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/actor-runs/{{ $('Extract Run ID').item.json.runId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "id": "check-run-status",
      "name": "Check Run Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-running",
              "leftValue": "={{ $json.data?.status }}",
              "rightValue": "RUNNING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1780, 300],
      "id": "still-running",
      "name": "Still Running?"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "minutes"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2000, 240],
      "id": "wait-more",
      "name": "Wait 2 More Min",
      "webhookId": "fb-wait-more"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/actor-runs/{{ $('Extract Run ID').item.json.runId }}/dataset/items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 380],
      "id": "get-results",
      "name": "Get Apify Results",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse FB Marketplace results from Apify\nconst results = $input.first().json;\nconst items = Array.isArray(results) ? results : (results.items || results.data || []);\n\n// Filter for property sales (not rentals)\nconst filteredItems = items.filter(item => {\n  const title = (item.title || item.name || '').toLowerCase();\n  const desc = (item.description || '').toLowerCase();\n  const combined = title + ' ' + desc;\n  const price = parseInt(String(item.price).replace(/[^0-9]/g, '')) || 0;\n  \n  // Must look like a sale, not rental\n  const saleKeywords = ['for sale', 'selling', 'fsbo', 'by owner', 'must sell', 'price reduced', 'obo'];\n  const rentalKeywords = ['for rent', 'rental', 'lease', '/month', 'per month', '/mo'];\n  \n  const isSale = saleKeywords.some(kw => combined.includes(kw)) || price > 50000;\n  const isRental = rentalKeywords.some(kw => combined.includes(kw));\n  \n  return isSale && !isRental;\n});\n\nreturn filteredItems.map(item => ({\n  json: {\n    title: item.title || item.name || '',\n    price: parseInt(String(item.price).replace(/[^0-9]/g, '')) || 0,\n    address: item.location?.address || item.address || '',\n    city: item.location?.city || '',\n    state: item.location?.state || 'TX',\n    zip: item.location?.zipcode || '',\n    description: item.description || '',\n    listing_url: item.url || item.link || '',\n    photo_url: (item.images && item.images[0]) || (item.photos && item.photos[0]) || '',\n    posted_date: item.postedDate || item.date || '',\n    seller_name: item.seller?.name || '',\n    source: 'FB Marketplace',\n    scraped_at: new Date().toISOString()\n  }\n})).filter(item => item.json.title || item.json.address);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 380],
      "id": "parse-results",
      "name": "Parse & Filter (Sales Only)"
    },
    {
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"anthropic/claude-3.5-sonnet\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this FB Marketplace listing for legitimacy as a real property sale:\\n\\nTitle: {{ $json.title }}\\nPrice: ${{ $json.price }}\\nDescription: {{ $json.description }}\\nLocation: {{ $json.city }}, {{ $json.state }}\\n\\nDetermine:\\n1. Is this a legitimate property for sale (not a scam, not a rental, not spam)?\\n2. Does it appear to be FSBO or owner-selling?\\n3. Extract the property address if mentioned\\n\\nReturn ONLY valid JSON:\\n{\\n  \\\"is_legitimate\\\": true/false,\\n  \\\"is_fsbo\\\": true/false,\\n  \\\"confidence\\\": 0.0-1.0,\\n  \\\"extracted_address\\\": \\\"Address if found or empty string\\\",\\n  \\\"red_flags\\\": [\\\"list any red flags\\\"],\\n  \\\"reason\\\": \\\"Brief explanation\\\"\\n}\"\n    }\n  ],\n  \"max_tokens\": 300,\n  \"temperature\": 0.3\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2440, 380],
      "id": "ai-legitimacy-check",
      "name": "AI Legitimacy Check",
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-auth",
          "name": "OpenRouter"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI legitimacy check results\nconst aiResponse = $input.first().json;\nconst listing = $('Parse & Filter (Sales Only)').item.json;\n\nlet analysis = {\n  is_legitimate: false,\n  is_fsbo: false,\n  confidence: 0,\n  extracted_address: '',\n  red_flags: [],\n  reason: 'Analysis failed'\n};\n\ntry {\n  const content = aiResponse.choices[0].message.content;\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    analysis = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Use defaults\n}\n\n// Use extracted address if we didn't have one\nconst address = listing.address || analysis.extracted_address || listing.title;\n\nreturn [{\n  json: {\n    ...listing,\n    address: address,\n    is_legitimate: analysis.is_legitimate,\n    is_fsbo: analysis.is_fsbo,\n    ai_confidence: analysis.confidence,\n    ai_red_flags: analysis.red_flags,\n    ai_reason: analysis.reason\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 380],
      "id": "parse-analysis",
      "name": "Parse AI Analysis"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-legit",
              "leftValue": "={{ $json.is_legitimate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "high-confidence",
              "leftValue": "={{ $json.ai_confidence }}",
              "rightValue": 0.6,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2880, 380],
      "id": "is-legitimate",
      "name": "Is Legitimate?"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "filterByFormula": "=OR({Listing URL} = '{{ $json.listing_url }}', AND({Address} = '{{ $json.address }}', {City} = '{{ $json.city }}'))"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [3100, 340],
      "id": "check-duplicate",
      "name": "Check If Exists",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
