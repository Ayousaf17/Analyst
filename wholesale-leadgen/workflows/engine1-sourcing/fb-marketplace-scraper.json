{
  "name": "FB Marketplace Scraper",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "id": "schedule-6h",
      "name": "Every 6 Hours"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "filterByFormula": "={Key} = 'target_cities'"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "get-cities",
      "name": "Get Target Cities",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse cities and create search URLs\n// Note: FB Marketplace requires authentication - use browser automation or third-party API\nconst settings = $input.first()?.json?.fields || {};\nlet cities = ['Austin'];\n\nif (settings.Value) {\n  try {\n    cities = JSON.parse(settings.Value);\n  } catch (e) {\n    cities = settings.Value.split(',').map(c => c.trim());\n  }\n}\n\n// FB Marketplace search parameters\nconst searches = cities.map(city => ({\n  city: city,\n  search_query: 'house for sale by owner',\n  // In production, use a marketplace scraping service like:\n  // - Apify (apify.com/actors)\n  // - ScrapingBee\n  // - BrightData\n  // Direct FB scraping is against ToS\n  api_url: `https://api.apify.com/v2/acts/YOUR_ACTOR_ID/runs`\n}));\n\nreturn searches.map(s => ({ json: s }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "prepare-searches",
      "name": "Prepare Search Queries"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 300],
      "id": "loop-cities",
      "name": "Loop Cities"
    },
    {
      "parameters": {
        "url": "https://api.apify.com/v2/acts/apify~facebook-marketplace-scraper/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchQuery\": \"{{ $json.search_query }}\",\n  \"location\": \"{{ $json.city }}, TX\",\n  \"maxItems\": 50,\n  \"categoryId\": \"propertyrentals\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 260],
      "id": "scrape-fb",
      "name": "Scrape FB Marketplace (Apify)",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Parse FB Marketplace results\n// This assumes using Apify or similar service\nconst response = $input.first().json;\nconst city = $('Loop Cities').item.json.city;\n\nlet listings = [];\n\nif (response && Array.isArray(response)) {\n  listings = response.map(item => ({\n    title: item.title || item.name,\n    price: parseInt(String(item.price).replace(/[^0-9]/g, '')) || 0,\n    location: item.location || city,\n    city: city,\n    description: item.description || '',\n    listing_url: item.url || item.link,\n    photos: item.images || item.photos || [],\n    posted_date: item.postedDate || item.date,\n    source: 'FB Marketplace',\n    scraped_at: new Date().toISOString()\n  }));\n} else if (response?.data) {\n  // Alternative response format\n  listings = response.data.map(item => ({\n    title: item.title,\n    price: parseInt(String(item.price).replace(/[^0-9]/g, '')) || 0,\n    city: city,\n    listing_url: item.url,\n    source: 'FB Marketplace',\n    scraped_at: new Date().toISOString()\n  }));\n}\n\n// Filter for property sales (not rentals)\nlistings = listings.filter(l => {\n  const title = (l.title || '').toLowerCase();\n  const desc = (l.description || '').toLowerCase();\n  const combined = title + ' ' + desc;\n  \n  // Must look like a sale, not rental\n  const saleKeywords = ['for sale', 'selling', 'fsbo', 'by owner', 'must sell', 'price reduced'];\n  const rentalKeywords = ['for rent', 'rental', 'lease', '/month', 'per month'];\n  \n  const isSale = saleKeywords.some(kw => combined.includes(kw)) || l.price > 50000;\n  const isRental = rentalKeywords.some(kw => combined.includes(kw));\n  \n  return isSale && !isRental;\n});\n\nreturn listings.map(l => ({ json: l }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 260],
      "id": "parse-listings",
      "name": "Parse FB Listings"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-title",
              "leftValue": "={{ $json.title }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "reasonable-price",
              "leftValue": "={{ $json.price }}",
              "rightValue": 20000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [1560, 260],
      "id": "filter-valid",
      "name": "Filter Valid (Price > $20K)"
    },
    {
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"anthropic/claude-3.5-sonnet\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this Facebook Marketplace real estate listing for legitimacy:\\n\\nTitle: {{ $json.title }}\\nPrice: ${{ $json.price }}\\nLocation: {{ $json.location || $json.city }}\\nDescription: {{ ($json.description || '').substring(0, 500) }}\\n\\nDetermine if this is a legitimate FSBO property listing or spam/scam.\\n\\nRed flags to check:\\n- Price too good to be true for the area\\n- Generic or stock-looking photos mentioned\\n- Requests for deposits/money upfront\\n- No specific address\\n- Rental disguised as sale\\n- Obvious scam patterns\\n- Too vague to be real\\n\\nReturn ONLY valid JSON:\\n{\\n  \\\"is_legitimate\\\": true or false,\\n  \\\"confidence\\\": 0-100,\\n  \\\"red_flags\\\": [\\\"flag1\\\", \\\"flag2\\\"],\\n  \\\"property_type\\\": \\\"house\\\" or \\\"condo\\\" or \\\"land\\\" or \\\"mobile_home\\\" or \\\"unknown\\\",\\n  \\\"is_fsbo\\\": true or false,\\n  \\\"estimated_condition\\\": \\\"good\\\" or \\\"fair\\\" or \\\"poor\\\" or \\\"unknown\\\",\\n  \\\"reason\\\": \\\"Brief explanation\\\"\\n}\"\n    }\n  ],\n  \"max_tokens\": 400,\n  \"temperature\": 0.2\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 260],
      "id": "ai-legitimacy",
      "name": "AI Legitimacy Check",
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-auth",
          "name": "OpenRouter"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response\nconst aiResponse = $input.first().json;\nconst listing = $('Filter Valid (Price > $20K)').item.json;\n\nlet analysis = {\n  is_legitimate: false,\n  confidence: 0,\n  red_flags: ['Could not analyze'],\n  reason: 'Analysis failed'\n};\n\ntry {\n  const content = aiResponse.choices[0].message.content;\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    analysis = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Use defaults\n}\n\nreturn [{\n  json: {\n    ...listing,\n    ai_analysis: analysis,\n    is_legitimate: analysis.is_legitimate,\n    legitimacy_confidence: analysis.confidence\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 260],
      "id": "parse-ai",
      "name": "Parse AI Response"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-legit",
              "leftValue": "={{ $json.is_legitimate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "confidence",
              "leftValue": "={{ $json.legitimacy_confidence }}",
              "rightValue": 50,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2220, 260],
      "id": "filter-legit",
