{
  "name": "Expired Listings Monitor (Apify)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "id": "schedule-6am",
      "name": "Daily 6 AM"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "filterByFormula": "={Key} = 'target_cities'"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "get-cities",
      "name": "Get Target Cities",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse cities for expired listing search via Apify\nconst settings = $input.first()?.json?.fields || {};\nlet cities = ['Austin, TX', 'San Antonio, TX', 'Houston, TX'];\n\nif (settings.Value) {\n  try {\n    cities = JSON.parse(settings.Value);\n  } catch (e) {\n    cities = settings.Value.split(',').map(c => c.trim());\n  }\n}\n\nreturn [{ json: { locations: cities } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "prepare-locations",
      "name": "Prepare Locations"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/maxcopell~realtor-scraper/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"location\": {{ JSON.stringify($json.locations) }},\n  \"status\": [\"off_market\", \"sold\"],\n  \"soldWithinDays\": 30,\n  \"maxItems\": 100,\n  \"includeOffMarket\": true,\n  \"proxy\": {\n    \"useApifyProxy\": true,\n    \"apifyProxyGroups\": [\"RESIDENTIAL\"]\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "id": "run-apify-actor",
      "name": "Run Apify Realtor Actor",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract the run ID from Apify response\nconst response = $input.first().json;\nconst runId = response.body?.data?.id || response.data?.id;\n\nif (!runId) {\n  throw new Error('Failed to start Apify actor - no run ID returned');\n}\n\nreturn [{ json: { runId: runId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "id": "extract-run-id",
      "name": "Extract Run ID"
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "minutes"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 300],
      "id": "wait-for-actor",
      "name": "Wait for Actor (3 min)",
      "webhookId": "realtor-apify-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/actor-runs/{{ $('Extract Run ID').item.json.runId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "id": "check-run-status",
      "name": "Check Run Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-running",
              "leftValue": "={{ $json.data?.status }}",
              "rightValue": "RUNNING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1780, 300],
      "id": "still-running",
      "name": "Still Running?"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "minutes"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2000, 240],
      "id": "wait-more",
      "name": "Wait 2 More Min",
      "webhookId": "realtor-wait-more"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.apify.com/v2/actor-runs/{{ $('Extract Run ID').item.json.runId }}/dataset/items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 380],
      "id": "get-results",
      "name": "Get Apify Results",
      "credentials": {
        "httpHeaderAuth": {
          "id": "apify-auth",
          "name": "Apify"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Apify Realtor results - filter for expired/withdrawn only\nconst results = $input.first().json;\nconst items = Array.isArray(results) ? results : (results.items || results.data || []);\n\n// Filter for listings that are expired, withdrawn, or recently off-market\nconst expiredListings = items.filter(item => {\n  const status = (item.status || item.listingStatus || '').toLowerCase();\n  const lastStatus = (item.last_status || '').toLowerCase();\n  \n  // Look for expired, withdrawn, or off-market indicators\n  return status.includes('off') || \n         status.includes('withdrawn') ||\n         status.includes('expired') ||\n         status.includes('cancelled') ||\n         lastStatus.includes('expired') ||\n         lastStatus.includes('withdrawn') ||\n         // Also include recently sold that failed (back on market potential)\n         (item.daysOnMarket > 180 && status.includes('sold'));\n});\n\nreturn expiredListings.map(item => ({\n  json: {\n    address: item.streetAddress || item.address || item.location?.address || '',\n    city: item.city || item.location?.city || '',\n    state: item.state || item.location?.state || 'TX',\n    zip: item.zipcode || item.postalCode || item.location?.postalCode || '',\n    price: item.listPrice || item.price || 0,\n    original_list_price: item.listPrice || item.price || 0,\n    bedrooms: item.beds || item.bedrooms || 0,\n    bathrooms: item.baths || item.bathrooms || 0,\n    sqft: item.sqft || item.livingArea || 0,\n    lot_size: item.lotSize || '',\n    year_built: item.yearBuilt || '',\n    property_type: item.propertyType || '',\n    listing_url: item.url || item.propertyUrl || '',\n    photo_url: item.primaryPhoto || (item.photos && item.photos[0]) || '',\n    days_on_market: item.daysOnMarket || item.dom || 0,\n    status_reason: item.status || item.last_status || 'Expired/Withdrawn',\n    mls_number: item.mlsId || item.listingId || '',\n    source: 'Expired MLS',\n    scraped_at: new Date().toISOString()\n  }\n})).filter(item => item.json.address);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 380],
      "id": "parse-expired",
      "name": "Parse Expired Listings"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [2440, 380],
      "id": "loop-leads",
      "name": "Loop Through Leads"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "filterByFormula": "=AND({Address} = '{{ $json.address }}', {City} = '{{ $json.city }}')"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [2660, 340],
      "id": "check-dup",
      "name": "Check Duplicate",
      "credentials": {
        "airtableTokenApi": {
