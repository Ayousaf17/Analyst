            {
              "fieldName": "Notes",
              "fieldValue": "=EXPIRED LISTING - HIGH MOTIVATION! Status: {{ $('Loop Through Leads').item.json.status_reason }}. DOM: {{ $('Loop Through Leads').item.json.days_on_market || 'Unknown' }}. MLS#: {{ $('Loop Through Leads').item.json.mls_number || 'N/A' }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [3100, 300],
      "id": "create-lead",
      "name": "Create Lead (Priority: High)",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
