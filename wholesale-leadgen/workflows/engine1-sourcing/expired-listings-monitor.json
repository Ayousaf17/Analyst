    {
      "parameters": {
        "channel": "#hot-leads",
        "text": "=:rotating_light: *Expired Listing Found!*\n\n*Property:* {{ $('Loop Through Leads').item.json.address }}, {{ $('Loop Through Leads').item.json.city }}\n*Original Price:* ${{ $('Loop Through Leads').item.json.price?.toLocaleString() || 'Unknown' }}\n*Days on Market:* {{ $('Loop Through Leads').item.json.days_on_market || 'Unknown' }}\n*Status:* {{ $('Loop Through Leads').item.json.status_reason }}\n*MLS#:* {{ $('Loop Through Leads').item.json.mls_number || 'N/A' }}\n\n:fire: *High motivation seller - listing expired/withdrawn!*\n:chart_with_upwards_trend: *15-25% conversion rate on expired listings*\n\nThis lead has been added with HIGH priority.",
        "otherOptions": {}
      },
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [3320, 300],
      "id": "slack-alert",
      "name": "Slack Alert (Expired = Gold)",
      "credentials": {
        "slackApi": {
          "id": "slack-creds",
          "name": "Slack"
        }
      }
    },
    {
