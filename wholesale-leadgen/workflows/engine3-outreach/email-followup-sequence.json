    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "filterByFormula": "=OR({Key} = 'your_name', {Key} = 'your_phone', {Key} = 'your_company', {Key} = 'your_email')"
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [900, 260],
      "id": "get-settings",
      "name": "Get Sender Settings",
      "credentials": {
        "airtableTokenApi": {
          "id": "airtable-creds",
          "name": "Airtable"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse settings and prepare leads for follow-up\nconst settings = $input.all();\nconst leads = $('Get Leads Needing Follow-up').all();\n\nconst config = {\n  your_name: 'Your Name',\n  your_phone: '(555) 555-5555',\n  your_company: 'Your Company',\n  your_email: 'your@email.com'\n};\n\nfor (const setting of settings) {\n  const key = setting.json.fields?.Key;\n  const value = setting.json.fields?.Value;\n  if (key && value) {\n    config[key] = value;\n  }\n}\n\n// Calculate follow-up number and days since last contact\nreturn leads.map(lead => {\n  const emailsSent = lead.json.fields['Emails Sent'] || 1;\n  const lastContact = new Date(lead.json.fields['Last Contact Date']);\n  const daysSince = Math.floor((Date.now() - lastContact) / (1000 * 60 * 60 * 24));\n  \n  // Determine follow-up type: Day 3, Day 7, or Day 14\n  let followUpType = 'day3';\n  if (emailsSent >= 2 || daysSince >= 7) {\n    followUpType = daysSince >= 10 ? 'day14' : 'day7';\n  }\n  \n  return {\n    json: {\n      ...lead.json,\n      config: config,\n      followUpType: followUpType,\n      daysSinceContact: daysSince,\n      nextEmailNumber: emailsSent + 1\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 260],
      "id": "prep-followup",
      "name": "Prepare Follow-up Data"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1340, 260],
      "id": "loop-leads",
      "name": "Loop Leads"
    },
    {
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"anthropic/claude-3.5-sonnet\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate a follow-up email for a property owner I contacted {{ $json.daysSinceContact }} days ago.\\n\\nFollow-up Type: {{ $json.followUpType }}\\nEmail Number: {{ $json.nextEmailNumber }} of 3\\n\\nOwner Name: {{ $json.fields['Owner Name'] || 'Homeowner' }}\\nProperty Address: {{ $json.fields.Address }}, {{ $json.fields.City }}\\nAsking Price: ${{ $json.fields['Asking Price'] || 'Not listed' }}\\nOriginal Source: {{ $json.fields.Source }}\\n\\nMy Info:\\n- Name: {{ $json.config.your_name }}\\n- Company: {{ $json.config.your_company }}\\n- Phone: {{ $json.config.your_phone }}\\n\\nFollow-up Approach by Type:\\n- day3: Friendly check-in, assume they're busy, offer to answer questions\\n- day7: Different value angle (speed of sale, no repairs needed, flexible timeline)\\n- day14: Last touch, acknowledge they may not be interested, leave door open\\n\\nGuidelines:\\n- Reference the previous outreach (\\\"I reached out last week...\\\")\\n- Don't repeat the same pitch - find a new angle\\n- Keep it shorter than the first email (under 100 words)\\n- Sound human, not automated\\n- Include soft call to action\\n\\nReturn ONLY valid JSON:\\n{\\n  \\\"subject\\\": \\\"Email subject line (reference previous email)\\\",\\n  \\\"body\\\": \\\"Email body text\\\",\\n  \\\"angle\\\": \\\"What approach was used\\\"\\n}\"\n    }\n  ],\n  \"max_tokens\": 500,\n  \"temperature\": 0.7\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 260],
      "id": "generate-followup",
      "name": "Generate Follow-up Email",
      "credentials": {
        "httpHeaderAuth": {
          "id": "openrouter-auth",
          "name": "OpenRouter"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI-generated follow-up email\nconst aiResponse = $input.first().json;\nconst lead = $('Loop Leads').item.json;\n\nlet email = {\n  subject: `Following up on ${lead.fields.Address}`,\n  body: 'Just wanted to follow up on my previous message...',\n  angle: 'Default follow-up'\n};\n\ntry {\n  const content = aiResponse.choices[0].message.content;\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    email = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Use defaults\n}\n\nreturn [{\n  json: {\n    lead: lead,\n    email: email\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 260],
      "id": "parse-email",
      "name": "Parse Email Response"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.lead.fields['Owner Email'] }}",
        "subject": "={{ $json.email.subject }}",
        "emailType": "text",
        "message": "={{ $json.email.body }}",
        "options": {
          "replyTo": "={{ $json.lead.config.your_email }}"
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [2000, 260],
      "id": "send-email",
      "name": "Send Follow-up Email",
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth",
          "name": "Gmail"
        }
      }
    },
    {
