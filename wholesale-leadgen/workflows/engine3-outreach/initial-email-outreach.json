            "index": 0
          }
        ]
      ]
    },
    "Get Ready Leads (No Email Sent)": {
      "main": [
        [
          {
            "node": "Has Leads?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Leads?": {
      "main": [
        [
          {
            "node": "Get Sender Settings",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Leads Ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
