    {
      "parameters": {
        "jsCode": "// Process charge.succeeded event\nconst data = $input.first().json.data;\n\n// Extract payment details\nconst amount = data.amount / 100; // Convert cents to dollars\nconst currency = data.currency.toUpperCase();\nconst chargeId = data.id;\nconst customerId = data.customer;\nconst customerName = data.billing_details?.name || data.customer_email || 'Unknown Customer';\nconst customerEmail = data.billing_details?.email || data.customer_email || '';\nconst description = data.description || 'Payment';\nconst receiptUrl = data.receipt_url || '';\n\n// Transaction date\nconst transactionDate = new Date(data.created * 1000).toISOString().split('T')[0];\n\n// Calculate fee (if balance_transaction is expanded)\nlet feeAmount = 0;\nlet netAmount = amount;\nif (data.balance_transaction && typeof data.balance_transaction === 'object') {\n  feeAmount = data.balance_transaction.fee / 100;\n  netAmount = data.balance_transaction.net / 100;\n} else {\n  // Estimate Stripe fee: 2.9% + $0.30\n  feeAmount = Math.round((amount * 0.029 + 0.30) * 100) / 100;\n  netAmount = amount - feeAmount;\n}\n\n// Payment method info\nconst paymentMethod = data.payment_method_details?.type || 'card';\nconst cardBrand = data.payment_method_details?.card?.brand || '';\nconst cardLast4 = data.payment_method_details?.card?.last4 || '';\n\nreturn [{\n  json: {\n    eventType: 'charge.succeeded',\n    chargeId,\n    customerId,\n    customerName,\n    customerEmail,\n    description,\n    amount,\n    feeAmount,\n    netAmount,\n    currency,\n    transactionDate,\n    paymentMethod,\n    cardInfo: cardBrand && cardLast4 ? `${cardBrand} ****${cardLast4}` : '',\n    receiptUrl,\n    incomeTitle: `${customerName} - ${description}`,\n    feeTitle: `Stripe Processing Fee - ${chargeId}`\n  }\n}];"
      },
