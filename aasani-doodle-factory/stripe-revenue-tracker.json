      "parameters": {
        "jsCode": "// Process invoice.paid event\nconst data = $input.first().json.data;\n\n// Determine if this is OUR expense or customer REVENUE\nconst customerEmail = data.customer_email || '';\nconst isOurExpense = customerEmail.includes('aasani.ai') || \n                     customerEmail.includes('ayub@') ||\n                     customerEmail === 'ayub@aasani.ai';\n\n// Extract invoice details\nconst invoiceId = data.id;\nconst amount = data.amount_paid / 100;\nconst currency = data.currency.toUpperCase();\nconst customerId = data.customer;\nconst customerName = data.customer_name || data.customer_email || 'Unknown';\nconst invoiceUrl = data.hosted_invoice_url || data.invoice_pdf || '';\nconst transactionDate = new Date(data.effective_at * 1000 || data.created * 1000).toISOString().split('T')[0];\n\n// Get line item descriptions\nlet description = 'Subscription Payment';\nif (data.lines && data.lines.data && data.lines.data.length > 0) {\n  description = data.lines.data.map(line => line.description || line.plan?.nickname || 'Subscription').join(', ');\n}\n\n// Subscription info\nconst subscriptionId = data.subscription || '';\nconst periodStart = data.period_start ? new Date(data.period_start * 1000).toISOString().split('T')[0] : '';\nconst periodEnd = data.period_end ? new Date(data.period_end * 1000).toISOString().split('T')[0] : '';\n\nreturn [{\n  json: {\n    eventType: 'invoice.paid',\n    isOurExpense,\n    invoiceId,\n    amount,\n    currency,\n    customerId,\n    customerName,\n    customerEmail,\n    description,\n    invoiceUrl,\n    transactionDate,\n    subscriptionId,\n    periodStart,\n    periodEnd,\n    title: isOurExpense ? `${description} Subscription` : `${customerName} - ${description}`\n  }\n}];"
      },
