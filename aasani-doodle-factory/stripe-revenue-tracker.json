        "jsCode": "// Process refund event\nconst data = $input.first().json.data;\n\nconst chargeId = data.id;\nconst refundId = data.refunds?.data?.[0]?.id || `refund_${chargeId}`;\nconst originalAmount = data.amount / 100;\nconst refundedAmount = data.amount_refunded / 100;\nconst customerName = data.billing_details?.name || 'Unknown';\nconst customerEmail = data.billing_details?.email || data.customer_email || '';\nconst transactionDate = new Date().toISOString().split('T')[0];\n\n// Refund reason\nconst reason = data.refunds?.data?.[0]?.reason || 'Customer request';\n\nreturn [{\n  json: {\n    eventType: 'charge.refunded',\n    chargeId,\n    refundId,\n    originalAmount,\n    refundedAmount,\n    customerName,\n    customerEmail,\n    transactionDate,\n    reason,\n    title: `REFUND: ${customerName} - $${refundedAmount.toFixed(2)}`\n  }\n}];"
      },
      "id": "code-process-refund",
      "name": "Code - Process Refund",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 820]
    },
    {
      "parameters": {
        "resource": "databasePage",
