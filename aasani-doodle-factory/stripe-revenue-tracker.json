      "parameters": {
        "jsCode": "// Process payment failed event\nconst data = $input.first().json.data;\n\nconst invoiceId = data.id;\nconst amount = (data.amount_due || data.total) / 100;\nconst customerName = data.customer_name || data.customer_email || 'Unknown';\nconst customerEmail = data.customer_email || '';\nconst transactionDate = new Date(data.created * 1000).toISOString().split('T')[0];\n\n// Failure details\nconst failureMessage = data.last_finalization_error?.message || \n                       data.charge?.failure_message || \n                       'Payment failed';\nconst attemptCount = data.attempt_count || 1;\nconst nextAttempt = data.next_payment_attempt \n  ? new Date(data.next_payment_attempt * 1000).toISOString()\n  : null;\n\n// Invoice URL for manual payment\nconst hostedInvoiceUrl = data.hosted_invoice_url || '';\n\nreturn [{\n  json: {\n    eventType: 'invoice.payment_failed',\n    invoiceId,\n    amount,\n    customerName,\n    customerEmail,\n    transactionDate,\n    failureMessage,\n    attemptCount,\n    nextAttempt,\n    hostedInvoiceUrl,\n    title: `FAILED: ${customerName} - $${amount.toFixed(2)}`\n  }\n}];"
      },
