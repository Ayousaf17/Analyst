    {
      "parameters": {
        "jsCode": "// Process subscription created/deleted\nconst data = $input.first().json.data;\nconst eventType = $input.first().json.eventType;\nconst isCreated = eventType === 'customer.subscription.created';\n\nconst subscriptionId = data.id;\nconst customerId = data.customer;\nconst status = data.status;\nconst canceledAt = data.canceled_at ? new Date(data.canceled_at * 1000).toISOString() : null;\n\n// Get plan details\nlet planName = 'Unknown Plan';\nlet amount = 0;\nlet interval = 'month';\n\nif (data.items && data.items.data && data.items.data.length > 0) {\n  const item = data.items.data[0];\n  planName = item.price?.nickname || item.plan?.nickname || 'Subscription';\n  amount = (item.price?.unit_amount || item.plan?.amount || 0) / 100;\n  interval = item.price?.recurring?.interval || item.plan?.interval || 'month';\n}\n\n// Current period\nconst periodStart = new Date(data.current_period_start * 1000).toISOString().split('T')[0];\nconst periodEnd = new Date(data.current_period_end * 1000).toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    eventType,\n    action: isCreated ? 'Created' : 'Canceled',\n    subscriptionId,\n    customerId,\n    status,\n    planName,\n    amount,\n    interval,\n    periodStart,\n    periodEnd,\n    canceledAt\n  }\n}];"
      },
