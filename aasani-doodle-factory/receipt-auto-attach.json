{
  "name": "Receipt Auto-Attach",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 5 }]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule - Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 20,
        "filters": {
          "q": "from:(receipts@framer.com OR noreply@openai.com OR receipts@anthropic.com OR noreply@stripe.com OR receipts@notion.so OR billing@vercel.com OR noreply@github.com OR aws@amazon.com) has:attachment is:unread newer_than:7d -label:Processed-n8n"
        },
        "options": { "downloadAttachments": true }
      },
      "id": "gmail-get-receipts",
      "name": "Gmail - Get Receipt Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [460, 300],
      "credentials": { "gmailOAuth2": { "id": "gmail-credential-id", "name": "Gmail - Aasani" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "combinator": "or",
          "conditions": [
            { "leftValue": "={{ $json.subject.toLowerCase() }}", "rightValue": "receipt", "operator": { "type": "string", "operation": "contains" } },
            { "leftValue": "={{ $json.subject.toLowerCase() }}", "rightValue": "invoice", "operator": { "type": "string", "operation": "contains" } },
            { "leftValue": "={{ $json.subject.toLowerCase() }}", "rightValue": "payment", "operator": { "type": "string", "operation": "contains" } }
          ]
        }
      },
      "id": "filter-valid-receipts",
      "name": "Filter - Valid Receipt Emails",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const email = $input.first().json;\nconst subject = email.subject || '';\nconst body = email.text || email.snippet || '';\nconst from = email.from || '';\n\nconst amountMatch = subject.match(/\\$([0-9,]+\\.\\d{2})/) || body.match(/\\$([0-9,]+\\.\\d{2})/);\nconst amount = amountMatch ? parseFloat(amountMatch[1].replace(',', '')) : null;\n\nconst senderDomainMatch = from.match(/@([a-zA-Z0-9.-]+)/i);\nconst domainMap = { 'framer.com': 'Framer', 'openai.com': 'OpenAI', 'anthropic.com': 'Anthropic', 'stripe.com': 'Stripe', 'vercel.com': 'Vercel', 'github.com': 'GitHub' };\nlet merchant = 'Unknown';\nif (senderDomainMatch) {\n  const domain = senderDomainMatch[1].toLowerCase();\n  merchant = domainMap[domain] || domain.split('.')[0];\n}\n\nconst emailDate = new Date(email.date || email.internalDate).toISOString().split('T')[0];\nlet attachment = null;\nif (email.attachments && email.attachments.length > 0) {\n  attachment = email.attachments.find(a => a.filename?.toLowerCase().endsWith('.pdf')) || email.attachments[0];\n}\n\nreturn [{ json: { emailId: email.id, subject, from, merchant, amount, date: emailDate, hasAttachment: !!attachment, attachmentName: attachment?.filename || '', attachmentData: attachment?.data || null } }];"
      },
      "id": "code-extract-data",
      "name": "Code - Extract Receipt Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [{ "leftValue": "={{ $json.hasAttachment }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }]
        }
      },
      "id": "if-has-attachment",
      "name": "IF - Has Attachment",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst date = new Date(input.date);\nconst year = date.getFullYear();\nconst month = String(date.getMonth() + 1).padStart(2, '0');\nlet filename = input.amount ? `${input.merchant}_${input.date}_$${input.amount.toFixed(2)}.pdf` : `${input.merchant}_${input.date}_Receipt.pdf`;\nfilename = filename.replace(/[<>:\"/\\\\|?*]/g, '_');\nreturn [{ json: { ...input, filename, year, month } }];"
      },
      "id": "code-build-path",
      "name": "Code - Build Drive Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "operation": "upload",
        "folderId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_DRIVE_RECEIPTS_FOLDER_ID }}" },
        "name": "={{ $json.filename }}"
      },
      "id": "google-drive-upload",
      "name": "Google Drive - Upload Receipt",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1560, 200],
      "credentials": { "googleDriveOAuth2Api": { "id": "google-drive-credential-id", "name": "Google Drive - Aasani" } }
    },
    {
      "parameters": {
        "operation": "share",
        "fileId": { "__rl": true, "mode": "id", "value": "={{ $json.id }}" },
        "permissionsUi": { "permissionsValues": { "role": "reader", "type": "anyone" } }
      },
      "id": "google-drive-share",
      "name": "Google Drive - Get Share Link",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1780, 200],
      "credentials": { "googleDriveOAuth2Api": { "id": "google-drive-credential-id", "name": "Google Drive - Aasani" } }
    },
    {
      "parameters": {
        "jsCode": "const fileId = $input.first().json.id;\nconst receiptUrl = `https://drive.google.com/file/d/${fileId}/view`;\nconst extractData = $('Code - Build Drive Path').first().json;\nreturn [{ json: { ...extractData, driveFileId: fileId, receiptUrl } }];"
      },
      "id": "code-get-url",
      "name": "Code - Get Share URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_FINANCE_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "Expenses" },
        "options": {}
      },
      "id": "sheets-get-expenses",
      "name": "Sheets - Get Expenses",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2220, 200],
      "credentials": { "googleSheetsOAuth2Api": { "id": "google-sheets-credential-id", "name": "Google Sheets - Aasani" } }
    },
    {
      "parameters": {
        "jsCode": "const receiptData = $('Code - Get Share URL').first().json;\nconst expenses = $input.all().map(item => item.json);\n\n// Filter to pending expenses within date range\nconst pending = expenses.filter(exp => {\n  if (exp['Receipt Status'] !== 'Missing') return false;\n  const expDate = new Date(exp.Date);\n  const receiptDate = new Date(receiptData.date);\n  const dateDiff = Math.abs(expDate - receiptDate) / (24 * 60 * 60 * 1000);\n  return dateDiff <= 3;\n});\n\nif (!pending.length) return [{ json: { ...receiptData, matched: false, reason: 'No pending expenses in date range' } }];\n\n// Match by merchant and amount\nlet bestMatch = null, bestScore = 0;\npending.forEach((exp, idx) => {\n  let score = 0;\n  if (exp.Merchant?.toLowerCase().includes(receiptData.merchant.toLowerCase())) score += 50;\n  if (receiptData.amount && Math.abs(exp.Amount - receiptData.amount) < 1) score += 50;\n  if (score > bestScore) { bestScore = score; bestMatch = { ...exp, rowIndex: idx + 2 }; }\n});\n\nconst matched = bestScore >= 50;\nreturn [{ json: { ...receiptData, matched, matchedExpense: matched ? bestMatch : null, matchScore: bestScore, reason: matched ? 'Found match' : 'No good match' } }];"
      },
      "id": "code-match-expense",
      "name": "Code - Match to Expense",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 200]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [{ "leftValue": "={{ $json.matched }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }]
        }
      },
      "id": "if-matched",
      "name": "IF - Matched",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2660, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEETS_FINANCE_ID }}" },
        "sheetName": { "__rl": true, "mode": "list", "value": "Expenses" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Receipt Status": "=Added",
            "Receipt URL": "={{ $json.receiptUrl }}"
          }
        },
        "options": { "cellFormat": "USER_ENTERED" }
      },
      "id": "sheets-update-expense",
      "name": "Sheets - Update Expense",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2880, 100],
      "credentials": { "googleSheetsOAuth2Api": { "id": "google-sheets-credential-id", "name": "Google Sheets - Aasani" } }
    },
    {
      "parameters": {
        "channel": "#all-aasani-systems",
        "text": "=:white_check_mark: *Receipt Auto-Attached*\n\n*Expense:* {{ $('Code - Match to Expense').item.json.merchant }}\n*Amount:* {{ $('Code - Match to Expense').item.json.amount ? '$' + $('Code - Match to Expense').item.json.amount.toFixed(2) : 'N/A' }}\n*Receipt:* {{ $('Code - Match to Expense').item.json.filename }}\n*Confidence:* {{ $('Code - Match to Expense').item.json.matchScore }}%\n\n_Updated in Google Sheets_"
      },
      "id": "slack-success",
      "name": "Slack - Success Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [3100, 100],
      "credentials": { "slackApi": { "id": "slack-credential-id", "name": "Slack - Aasani" } }
    },
    {
      "parameters": {
        "channel": "#all-aasani-systems",
        "text": "=:warning: *Unmatched Receipt*\n\nReceived receipt that couldn't be matched:\n*Merchant:* {{ $json.merchant }}\n*Amount:* {{ $json.amount ? '$' + $json.amount.toFixed(2) : 'Not detected' }}\n*Reason:* {{ $json.reason }}\n\nReceipt saved to Drive: <{{ $json.receiptUrl }}|View Receipt>"
      },
      "id": "slack-unmatched",
      "name": "Slack - Unmatched Notification",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [2880, 300],
      "credentials": { "slackApi": { "id": "slack-credential-id", "name": "Slack - Aasani" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "markAsRead",
        "messageId": "={{ $('Code - Extract Receipt Data').item.json.emailId }}"
      },
      "id": "gmail-mark-read",
      "name": "Gmail - Mark as Read",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [3320, 200],
      "credentials": { "gmailOAuth2": { "id": "gmail-credential-id", "name": "Gmail - Aasani" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "addLabels",
        "messageId": "={{ $('Code - Extract Receipt Data').item.json.emailId }}",
        "labelIds": ["Processed-n8n"]
      },
      "id": "gmail-add-label",
      "name": "Gmail - Add Processed Label",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [3540, 200],
      "credentials": { "gmailOAuth2": { "id": "gmail-credential-id", "name": "Gmail - Aasani" } }
    }
  ],
  "connections": {
    "Schedule - Every 5 Minutes": { "main": [[{ "node": "Gmail - Get Receipt Emails", "type": "main", "index": 0 }]] },
    "Gmail - Get Receipt Emails": { "main": [[{ "node": "Filter - Valid Receipt Emails", "type": "main", "index": 0 }]] },
    "Filter - Valid Receipt Emails": { "main": [[{ "node": "Code - Extract Receipt Data", "type": "main", "index": 0 }]] },
    "Code - Extract Receipt Data": { "main": [[{ "node": "IF - Has Attachment", "type": "main", "index": 0 }]] },
    "IF - Has Attachment": { "main": [[{ "node": "Code - Build Drive Path", "type": "main", "index": 0 }], []] },
    "Code - Build Drive Path": { "main": [[{ "node": "Google Drive - Upload Receipt", "type": "main", "index": 0 }]] },
    "Google Drive - Upload Receipt": { "main": [[{ "node": "Google Drive - Get Share Link", "type": "main", "index": 0 }]] },
    "Google Drive - Get Share Link": { "main": [[{ "node": "Code - Get Share URL", "type": "main", "index": 0 }]] },
    "Code - Get Share URL": { "main": [[{ "node": "Sheets - Get Expenses", "type": "main", "index": 0 }]] },
    "Sheets - Get Expenses": { "main": [[{ "node": "Code - Match to Expense", "type": "main", "index": 0 }]] },
    "Code - Match to Expense": { "main": [[{ "node": "IF - Matched", "type": "main", "index": 0 }]] },
    "IF - Matched": { "main": [[{ "node": "Sheets - Update Expense", "type": "main", "index": 0 }], [{ "node": "Slack - Unmatched Notification", "type": "main", "index": 0 }]] },
    "Sheets - Update Expense": { "main": [[{ "node": "Slack - Success Notification", "type": "main", "index": 0 }]] },
    "Slack - Success Notification": { "main": [[{ "node": "Gmail - Mark as Read", "type": "main", "index": 0 }]] },
    "Slack - Unmatched Notification": { "main": [[{ "node": "Gmail - Mark as Read", "type": "main", "index": 0 }]] },
    "Gmail - Mark as Read": { "main": [[{ "node": "Gmail - Add Processed Label", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "tags": [{ "name": "Finance", "id": "finance-tag" }, { "name": "Receipts", "id": "receipts-tag" }, { "name": "Google Sheets", "id": "sheets-tag" }],
  "meta": { "templateCredsSetupCompleted": true, "instanceId": "aasani-instance" }
}
