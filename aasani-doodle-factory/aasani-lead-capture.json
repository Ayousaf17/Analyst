    {
      "parameters": {
        "sendTo": "={{ $json.lead.email }}",
        "subject": "Thanks for reaching out to Aasani Systems",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <p>Hi {{ $json.lead.name }},</p>\n  \n  <p>Thanks for reaching out! I received your message about workflow automation.</p>\n  \n  <p>I'll review your challenge and get back to you within 24 hours with some initial thoughts on how we can help.</p>\n  \n  <p>In the meantime, here's a quick look at our approach:</p>\n  \n  <blockquote style=\"border-left: 3px solid #1a1a2e; padding-left: 15px; margin: 20px 0; color: #555;\">\n    <strong>\"Structure Before Intelligence\"</strong><br>\n    We build systematic foundations BEFORE implementing AI. This ensures your automations are reliable, maintainable, and actually solve the right problems.\n  </blockquote>\n  \n  <p>Looking forward to connecting,</p>\n  \n  <p style=\"margin-top: 30px;\">\n    <strong>Ayub Yousaf</strong><br>\n    Founder, Aasani Systems<br>\n    <a href=\"https://aasani.ai\" style=\"color: #4A90D9;\">aasani.ai</a>\n  </p>\n</div>",
        "options": {
          "replyTo": "ayub@aasani.ai"
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1320, 200],
      "id": "gmail-auto-reply",
      "name": "Send Auto-Reply Email",
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-ayub",
          "name": "Google Workspace - Ayub"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "ayub@aasani.ai",
        "subject": "=🚨 New Lead: {{ $json.lead.name }} from {{ $json.lead.company }}",
        "message": "=<div style=\"font-family: Arial, sans-serif;\">\n  <h2 style=\"color: #1a1a2e;\">New Lead Captured from aasani.ai</h2>\n  \n  <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n    <tr>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\"><strong>Name:</strong></td>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\">{{ $json.lead.name }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\"><strong>Email:</strong></td>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\"><a href=\"mailto:{{ $json.lead.email }}\">{{ $json.lead.email }}</a></td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\"><strong>Company:</strong></td>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\">{{ $json.lead.company }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\"><strong>Phone:</strong></td>\n      <td style=\"padding: 10px; border-bottom: 1px solid #eee;\">{{ $json.lead.phone || 'Not provided' }}</td>\n    </tr>\n  </table>\n  \n  <div style=\"background: #f5f5f5; padding: 15px; border-radius: 5px; margin: 20px 0;\">\n    <strong>Message:</strong><br>\n    <p style=\"margin: 10px 0 0 0;\">{{ $json.lead.message }}</p>\n  </div>\n  \n  <table style=\"width: 100%; margin: 20px 0;\">\n    <tr>\n      <td><strong>Source:</strong> Website Form</td>\n      <td><strong>Added to CRM:</strong> ✅ Yes</td>\n    </tr>\n    <tr>\n      <td><strong>Status:</strong> {{ $json.is_duplicate ? '⚠️ Duplicate (Updated)' : '🆕 New Lead' }}</td>\n      <td><strong>Follow up by:</strong> Tomorrow</td>\n    </tr>\n  </table>\n  \n  <p style=\"margin-top: 20px;\">\n    <a href=\"https://www.notion.so/{{ $json.notion_record_id.replace(/-/g, '') }}\" style=\"background: #4A90D9; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;\">View in Notion</a>\n  </p>\n</div>",
        "options": {}
