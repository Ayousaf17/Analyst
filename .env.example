# Gorgias Slack Terminal - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# This file is safe to commit to git (contains no secrets)

# ============================================
# OpenAI Configuration
# ============================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_MAX_TOKENS=8000
OPENAI_TEMPERATURE_PLAN=0.3
OPENAI_TEMPERATURE_CONVERSATION=0.7

# ============================================
# Gorgias Configuration
# ============================================
# Replace 'ironside' with your Gorgias subdomain
GORGIAS_BASE_URL=https://your-company.gorgias.com
GORGIAS_API_VERSION=v1

# ============================================
# Supabase Configuration
# ============================================
# Get your project URL from Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_API_VERSION=v1

# ============================================
# Slack Configuration
# ============================================
# Channels for error and log notifications
SLACK_ERROR_CHANNEL=#gorgias-errors
SLACK_LOG_CHANNEL=#gorgias-logs

# ============================================
# Workflow Configuration
# ============================================
# Timeout in seconds (3600 = 1 hour)
EXECUTION_TIMEOUT=3600
# Number of retry attempts on failure
RETRY_COUNT=3
# Delay between retries in milliseconds
RETRY_DELAY=1000
