        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a real estate market analyst. Generate a weekly market update for Austin, TX real estate. Include general market trends, buyer/seller tips, and a positive outlook. Return JSON with keys: subject, intro, market_stats_html, buyer_tips, seller_tips, outlook, social_post.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate weekly market update for the week of {{ $now.toISODate() }}. Focus on Austin, TX metro area. Include helpful tips and market insights. Agent: YOUR_AGENT_NAME. Return valid JSON only.\"\n    }\n  ],\n  \"max_tokens\": 1500\n}",
