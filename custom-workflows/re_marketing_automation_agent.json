    {
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a real estate marketing expert. Generate engaging social media content for property listings. Create content for Instagram, Facebook, and LinkedIn. Return JSON with keys: instagram_caption (max 2200 chars with emojis and hashtags), facebook_post (engaging with call to action), linkedin_post (professional tone), email_subject, email_body_html.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate marketing content for NEW LISTING:\\n- Address: {{ $json.property_address }}\\n- City: {{ $json.city }}\\n- Price: ${{ $json.price?.toLocaleString() }}\\n- Beds: {{ $json.bedrooms }}\\n- Baths: {{ $json.bathrooms }}\\n- Sqft: {{ $json.sqft?.toLocaleString() }}\\n- Features: {{ $json.key_features }}\\n- Agent: {{ $json.agent_name }}\\n- Phone: {{ $json.agent_phone }}\\n\\nReturn valid JSON only.\"\n    }\n  ],\n  \"max_tokens\": 1500\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 100],
      "id": "generate-listing-content",
      "name": "Generate Listing Content",
      "credentials": {
        "httpHeaderAuth": {
          "id": "OPENROUTER_CREDENTIAL_ID",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a real estate marketing expert. Generate engaging content for a listing update (price reduction or status change). Create urgency without being pushy. Return JSON with keys: instagram_caption, facebook_post, email_subject, email_body_html.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate content for {{ $json.event_type === 'price_reduced' ? 'PRICE REDUCTION' : 'UNDER CONTRACT' }}:\\n- Address: {{ $json.property_address }}\\n- Update Type: {{ $json.update_type }}\\n{{ $json.event_type === 'price_reduced' ? '- Old Price: $' + $json.old_price?.toLocaleString() + '\\n- New Price: $' + $json.new_price?.toLocaleString() + '\\n- Savings: $' + ($json.old_price - $json.new_price)?.toLocaleString() : '' }}\\n\\nReturn valid JSON only.\"\n    }\n  ],\n  \"max_tokens\": 1000\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "id": "generate-update-content",
      "name": "Generate Update Content",
      "credentials": {
        "httpHeaderAuth": {
          "id": "OPENROUTER_CREDENTIAL_ID",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a real estate marketing expert. Generate celebratory 'Just Sold' content that showcases success without revealing private details. Focus on the agent's expertise and results. Return JSON with keys: instagram_caption (celebratory with hashtags), facebook_post (testimonial request included), linkedin_post (professional achievement), email_subject, email_body_html.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate JUST SOLD content:\\n- Address: {{ $json.property_address }}\\n- Sale Price: ${{ $json.sale_price?.toLocaleString() }}\\n- Days on Market: {{ $json.days_on_market }}\\n- Client (optional): {{ $json.client_name || 'Happy Clients' }}\\n\\nReturn valid JSON only.\"\n    }\n  ],\n  \"max_tokens\": 1200\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 500],
      "id": "generate-sold-content",
      "name": "Generate Just Sold Content",
      "credentials": {
        "httpHeaderAuth": {
          "id": "OPENROUTER_CREDENTIAL_ID",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response and extract content\nconst response = $input.first().json;\nconst content = response.choices[0].message.content;\n\nlet parsed = {};\ntry {\n  // Try to extract JSON from the response\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Fallback content\n  parsed = {\n    instagram_caption: '🏠 New listing alert! Contact us for details. #realestate #newlisting',\n    facebook_post: 'Excited to share this new listing! Reach out for more information.',\n    linkedin_post: 'Pleased to announce a new property listing. Contact me for details.',\n    email_subject: 'New Listing Alert',\n    email_body_html: '<p>Check out our latest listing!</p>'\n  };\n}\n\n// Get the original data\nlet eventData = {};\ntry {\n  eventData = $('Set New Listing Data').item?.json || $('Set Update Data').item?.json || $('Set Just Sold Data').item?.json || {};\n} catch (e) {\n  eventData = {};\n}\n\nreturn [{\n  json: {\n    ...eventData,\n    ...parsed,\n    generated_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 100],
      "id": "parse-listing-content",
      "name": "Parse Listing Content"
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response for updates\nconst response = $input.first().json;\nconst content = response.choices[0].message.content;\n\nlet parsed = {};\ntry {\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  parsed = {\n    instagram_caption: '📢 Listing update! Contact us for details. #realestate',\n    facebook_post: 'Important update on this property!',\n    email_subject: 'Listing Update',\n    email_body_html: '<p>There has been an update to this listing.</p>'\n  };\n}\n\nconst eventData = $('Set Update Data').item?.json || {};\n\nreturn [{\n  json: {\n    ...eventData,\n    ...parsed,\n    generated_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300],
      "id": "parse-update-content",
      "name": "Parse Update Content"
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response for just sold\nconst response = $input.first().json;\nconst content = response.choices[0].message.content;\n\nlet parsed = {};\ntry {\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  parsed = {\n    instagram_caption: '🎉 JUST SOLD! Another happy client! #justsold #realestate',\n    facebook_post: 'Thrilled to announce another successful closing!',\n    linkedin_post: 'Pleased to share another successful transaction.',\n    email_subject: 'Just Sold!',\n    email_body_html: '<p>Another successful sale!</p>'\n  };\n}\n\nconst eventData = $('Set Just Sold Data').item?.json || {};\n\nreturn [{\n  json: {\n    ...eventData,\n    ...parsed,\n    generated_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 500],
      "id": "parse-sold-content",
      "name": "Parse Sold Content"
    },
