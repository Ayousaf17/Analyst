        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a helpful real estate assistant. Generate a warm, personalized email for a new lead. Be friendly and professional. Include:\\n1. Acknowledge their inquiry\\n2. Brief intro of yourself\\n3. Next step suggestion (call or property details)\\n4. Professional signature\\n\\nKeep concise - 3-4 short paragraphs max.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate an instant response email for:\\n- Lead Name: {{ $json.lead_name }}\\n- Full Name: {{ $json.lead_full_name }}\\n- Inquiry Type: {{ $json.inquiry_type }}\\n- Property Interest: {{ $json.property_interest }}\\n- Buyer/Seller: {{ $json.buyer_or_seller }}\\n- Lead Source: {{ $json.lead_source }}\\n- Agent Name: {{ $json.agent_name }}\\n- Agent Phone: {{ $json.agent_phone }}\"\n    }\n  ],\n  \"max_tokens\": 500\n}",
