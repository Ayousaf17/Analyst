        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a helpful real estate assistant. Generate a warm, personalized SMS message (max 160 chars) for a new lead. Be friendly but professional. Include a question to encourage response. Sign with the agent's first name only.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate an instant response SMS for:\\n- Lead Name: {{ $json.lead_name }}\\n- Inquiry Type: {{ $json.inquiry_type }}\\n- Property Interest: {{ $json.property_interest }}\\n- Buyer/Seller: {{ $json.buyer_or_seller }}\\n- Agent Name: {{ $json.agent_name }}\\n\\nKeep under 160 characters.\"\n    }\n  ],\n  \"max_tokens\": 100\n}",
        "options": {}
