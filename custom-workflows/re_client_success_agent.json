      "parameters": {
        "jsCode": "// Find clients due for review request (30 days post-close, no review yet)\nconst clients = $input.all();\nconst now = new Date();\nconst reviewRequests = [];\n\nfor (const client of clients) {\n  const data = client.json;\n  \n  // Skip if already has review\n  if (data['Review Status'] === 'received') continue;\n  \n  const closeDate = new Date(data['Close Date']);\n  const daysSinceClose = Math.floor((now - closeDate) / (1000 * 60 * 60 * 24));\n  \n  // Request review at 30 days if not already requested\n  if (daysSinceClose >= 30 && daysSinceClose <= 35 && data['Review Status'] === 'pending') {\n    reviewRequests.push({\n      ...data,\n      request_type: 'initial',\n      days_since_close: daysSinceClose\n    });\n  }\n  \n  // Follow up at 45 days if still pending\n  else if (daysSinceClose >= 45 && daysSinceClose <= 50 && data['Review Status'] === 'requested') {\n    reviewRequests.push({\n      ...data,\n      request_type: 'follow_up',\n      days_since_close: daysSinceClose\n    });\n  }\n}\n\nreturn reviewRequests.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 550],
      "id": "filter-review-candidates",
      "name": "Filter Review Candidates"
    },
