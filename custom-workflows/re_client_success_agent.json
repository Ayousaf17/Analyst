        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a real estate agent assistant. Generate a warm check-in email for a past client. Don't be salesy - just genuinely check in on them. Maybe share a quick market update for their neighborhood or ask how they're enjoying their home. Include a subtle reminder that you're there for referrals.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate sphere nurture email for:\\n- Name: {{ $json.Name }}\\n- Property: {{ $json['Property Address'] }}\\n- Days since last contact: {{ $json.days_since_contact }}\\n- Nurture type: {{ $json.nurture_type }}\\n- Agent: YOUR_AGENT_NAME\"\n    }\n  ],\n  \"max_tokens\": 400\n}",
