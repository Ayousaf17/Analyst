    {
      "parameters": {
        "jsCode": "// Find clients due for sphere nurture (90+ days since last contact)\nconst clients = $input.all();\nconst now = new Date();\nconst needsNurture = [];\n\nfor (const client of clients) {\n  const data = client.json;\n  \n  const lastContact = data['Last Contact'] ? new Date(data['Last Contact']) : new Date(data['Close Date']);\n  const daysSinceContact = Math.floor((now - lastContact) / (1000 * 60 * 60 * 24));\n  \n  // Nurture if 90+ days since last contact\n  if (daysSinceContact >= 90) {\n    needsNurture.push({\n      ...data,\n      days_since_contact: daysSinceContact,\n      nurture_type: daysSinceContact >= 180 ? 'long_absence' : 'regular'\n    });\n  }\n}\n\n// Limit to 5 per week to keep it manageable\nreturn needsNurture.slice(0, 5).map(n => ({ json: n }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 750],
      "id": "filter-sphere-nurture",
      "name": "Filter Sphere for Nurture"
