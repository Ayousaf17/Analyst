      "parameters": {
        "jsCode": "// Check for anniversaries and birthdays\nconst clients = $input.all();\nconst today = new Date();\nconst todayMMDD = (today.getMonth() + 1).toString().padStart(2, '0') + '-' + today.getDate().toString().padStart(2, '0');\n\nconst celebrations = [];\n\nfor (const client of clients) {\n  const data = client.json;\n  \n  // Check close date anniversary (home anniversary)\n  if (data['Close Date']) {\n    const closeDate = new Date(data['Close Date']);\n    const closeMMDD = (closeDate.getMonth() + 1).toString().padStart(2, '0') + '-' + closeDate.getDate().toString().padStart(2, '0');\n    \n    if (closeMMDD === todayMMDD && closeDate.getFullYear() !== today.getFullYear()) {\n      const years = today.getFullYear() - closeDate.getFullYear();\n      celebrations.push({\n        ...data,\n        celebration_type: 'home_anniversary',\n        years: years,\n        message_context: `${years} year${years > 1 ? 's' : ''} in their home at ${data['Property Address']}`\n      });\n    }\n  }\n  \n  // Check birthday\n  if (data.Birthday) {\n    const birthday = new Date(data.Birthday);\n    const bdayMMDD = (birthday.getMonth() + 1).toString().padStart(2, '0') + '-' + birthday.getDate().toString().padStart(2, '0');\n    \n    if (bdayMMDD === todayMMDD) {\n      celebrations.push({\n        ...data,\n        celebration_type: 'birthday',\n        message_context: 'Birthday celebration'\n      });\n    }\n  }\n}\n\nreturn celebrations.map(c => ({ json: c }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 350],
      "id": "check-anniversaries",
      "name": "Check Anniversaries & Birthdays"
