    {
      "parameters": {
        "jsCode": "// Aggregate data from all agents for unified dashboard\nconst leads = $('Get All Leads').all();\nconst transactions = $('Get All Transactions').all();\nconst clients = $('Get All Clients').all();\n\nconst now = new Date();\nconst today = now.toISOString().split('T')[0];\n\n// Lead metrics\nconst activeLeads = leads.filter(l => l.json.Status !== 'Converted' && l.json.Status !== 'Lost').length;\nconst newLeadsToday = leads.filter(l => l.json['Received At']?.split('T')[0] === today).length;\nconst convertedThisMonth = leads.filter(l => {\n  if (l.json.Status !== 'Converted') return false;\n  const converted = new Date(l.json['Converted At']);\n  return converted.getMonth() === now.getMonth() && converted.getFullYear() === now.getFullYear();\n}).length;\n\n// Transaction metrics\nconst activeTransactions = transactions.filter(t => t.json.Status === 'Active').length;\nconst closingThisWeek = transactions.filter(t => {\n  if (t.json.Status !== 'Active') return false;\n  const closing = new Date(t.json['Closing Date']);\n  const weekFromNow = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);\n  return closing <= weekFromNow && closing >= now;\n}).length;\nconst closedThisMonth = transactions.filter(t => {\n  if (t.json.Status !== 'Closed') return false;\n  const closed = new Date(t.json['Closed At']);\n  return closed.getMonth() === now.getMonth() && closed.getFullYear() === now.getFullYear();\n}).length;\n\n// Client metrics\nconst totalClients = clients.length;\nconst reviewsReceived = clients.filter(c => c.json['Review Status'] === 'received').length;\nconst referrals = clients.reduce((sum, c) => sum + parseInt(c.json['Referral Count'] || 0), 0);\n\n// Pipeline value\nconst pipelineValue = transactions\n  .filter(t => t.json.Status === 'Active')\n  .reduce((sum, t) => sum + parseFloat(t.json['Purchase Price'] || 0), 0);\n\nreturn [{\n  json: {\n    date: today,\n    lead_metrics: {\n      active: activeLeads,\n      new_today: newLeadsToday,\n      converted_this_month: convertedThisMonth\n    },\n    transaction_metrics: {\n      active: activeTransactions,\n      closing_this_week: closingThisWeek,\n      closed_this_month: closedThisMonth,\n      pipeline_value: pipelineValue\n    },\n    client_metrics: {\n      total: totalClients,\n      reviews_received: reviewsReceived,\n      referrals: referrals\n    },\n    agent_status: {\n      lead_nurturing: 'Active',\n      transaction_coordinator: 'Active',\n      marketing_automation: 'Active',\n      client_success: 'Active'\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 800],
      "id": "aggregate-metrics",
      "name": "Aggregate All Metrics"
    },
