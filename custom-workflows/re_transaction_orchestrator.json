      "parameters": {
        "jsCode": "// Generate weekly performance report\nconst events = $input.all();\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\n\nconst weeklyEvents = events.filter(e => {\n  const eventDate = new Date(e.json.Timestamp);\n  return eventDate >= weekAgo;\n});\n\nconst eventsByType = {};\nfor (const event of weeklyEvents) {\n  const type = event.json['Event Type'];\n  eventsByType[type] = (eventsByType[type] || 0) + 1;\n}\n\nconst eventsByAgent = {};\nfor (const event of weeklyEvents) {\n  const source = event.json['Source Agent'];\n  eventsByAgent[source] = (eventsByAgent[source] || 0) + 1;\n}\n\nreturn [{\n  json: {\n    week_ending: now.toISOString().split('T')[0],\n    total_events: weeklyEvents.length,\n    events_by_type: eventsByType,\n    events_by_agent: eventsByAgent,\n    summary: {\n      lead_conversions: eventsByType['Lead Converted'] || 0,\n      transactions_closed: eventsByType['Transaction Closed'] || 0,\n      new_listings: eventsByType['New Listing'] || 0\n    }\n  }\n}];"
      },
