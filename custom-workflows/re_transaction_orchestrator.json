      "parameters": {
        "sendTo": "YOUR_AGENT_EMAIL",
        "subject": "=📊 Daily Dashboard - {{ $json.date }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 700px; margin: 0 auto;\">\n  <h1 style=\"color: #2c5282;\">📊 Daily Dashboard</h1>\n  <p style=\"color: #666;\">{{ $json.date }}</p>\n  \n  <div style=\"display: flex; gap: 15px; margin: 20px 0; flex-wrap: wrap;\">\n    <div style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 10px; flex: 1; min-width: 150px;\">\n      <h3 style=\"margin: 0;\">Active Leads</h3>\n      <p style=\"font-size: 32px; margin: 10px 0 0;\">{{ $json.lead_metrics.active }}</p>\n    </div>\n    <div style=\"background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 20px; border-radius: 10px; flex: 1; min-width: 150px;\">\n      <h3 style=\"margin: 0;\">Active Deals</h3>\n      <p style=\"font-size: 32px; margin: 10px 0 0;\">{{ $json.transaction_metrics.active }}</p>\n    </div>\n    <div style=\"background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; padding: 20px; border-radius: 10px; flex: 1; min-width: 150px;\">\n      <h3 style=\"margin: 0;\">Pipeline Value</h3>\n      <p style=\"font-size: 24px; margin: 10px 0 0;\">${{ ($json.transaction_metrics.pipeline_value / 1000000).toFixed(1) }}M</p>\n    </div>\n    <div style=\"background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; padding: 20px; border-radius: 10px; flex: 1; min-width: 150px;\">\n      <h3 style=\"margin: 0;\">Total Clients</h3>\n      <p style=\"font-size: 32px; margin: 10px 0 0;\">{{ $json.client_metrics.total }}</p>\n    </div>\n  </div>\n  \n  <h2>Lead Nurturing Agent</h2>\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr><td style=\"padding: 8px; border-bottom: 1px solid #eee;\">New Leads Today</td><td style=\"padding: 8px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;\">{{ $json.lead_metrics.new_today }}</td></tr>\n    <tr><td style=\"padding: 8px; border-bottom: 1px solid #eee;\">Converted This Month</td><td style=\"padding: 8px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;\">{{ $json.lead_metrics.converted_this_month }}</td></tr>\n  </table>\n  \n  <h2>Transaction Coordinator Agent</h2>\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr><td style=\"padding: 8px; border-bottom: 1px solid #eee;\">Closing This Week</td><td style=\"padding: 8px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold; {{ $json.transaction_metrics.closing_this_week > 0 ? 'color: #38a169;' : '' }}\">{{ $json.transaction_metrics.closing_this_week }}</td></tr>\n    <tr><td style=\"padding: 8px; border-bottom: 1px solid #eee;\">Closed This Month</td><td style=\"padding: 8px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;\">{{ $json.transaction_metrics.closed_this_month }}</td></tr>\n  </table>\n  \n  <h2>Client Success Agent</h2>\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr><td style=\"padding: 8px; border-bottom: 1px solid #eee;\">Reviews Received</td><td style=\"padding: 8px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;\">{{ $json.client_metrics.reviews_received }}</td></tr>\n    <tr><td style=\"padding: 8px; border-bottom: 1px solid #eee;\">Total Referrals</td><td style=\"padding: 8px; border-bottom: 1px solid #eee; text-align: right; font-weight: bold;\">{{ $json.client_metrics.referrals }}</td></tr>\n  </table>\n  \n  <h2>Agent Status</h2>\n  <div style=\"display: flex; gap: 10px; flex-wrap: wrap;\">\n    <span style=\"background: #c6f6d5; color: #276749; padding: 5px 15px; border-radius: 20px;\">✓ Lead Nurturing</span>\n    <span style=\"background: #c6f6d5; color: #276749; padding: 5px 15px; border-radius: 20px;\">✓ Transaction Coord</span>\n    <span style=\"background: #c6f6d5; color: #276749; padding: 5px 15px; border-radius: 20px;\">✓ Marketing</span>\n    <span style=\"background: #c6f6d5; color: #276749; padding: 5px 15px; border-radius: 20px;\">✓ Client Success</span>\n  </div>\n  \n  <hr style=\"margin: 30px 0; border: none; border-top: 1px solid #eee;\">\n  <p style=\"color: #666; font-size: 12px;\">Generated by RE Transaction Orchestrator</p>\n</div>",
        "options": {}
