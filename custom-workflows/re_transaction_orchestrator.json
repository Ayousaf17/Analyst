    {
      "parameters": {
        "jsCode": "// Find buyer leads that might be interested in this listing\nconst leads = $input.all();\nconst listing = $('Prepare Listing Data').item.json;\nconst matches = [];\n\nfor (const lead of leads) {\n  const data = lead.json;\n  \n  // Skip converted or lost leads\n  if (data.Status === 'Converted' || data.Status === 'Lost') continue;\n  \n  // Check if buyer lead\n  if (data.Type !== 'buyer') continue;\n  \n  // Add as potential match (in real implementation, would match on criteria)\n  matches.push({\n    lead_id: data['Lead ID'],\n    lead_name: data.Name,\n    lead_email: data.Email,\n    listing_id: listing.listing_id,\n    listing_address: listing.property_address,\n    listing_price: listing.price\n  });\n}\n\n// Limit to top 10 matches\nreturn matches.slice(0, 10).map(m => ({ json: m }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 560],
      "id": "match-buyer-leads",
      "name": "Match Buyer Leads"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-matches",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 560],
      "id": "has-matches",
      "name": "Has Matches?"
    },
    {
      "parameters": {
        "sendTo": "YOUR_AGENT_EMAIL",
