        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif;\">\n  <h2>New Listing Matched with Buyer Leads</h2>\n  \n  <h3>Listing: {{ $('Prepare Listing Data').item.json.property_address }}</h3>\n  <p>Price: ${{ $('Prepare Listing Data').item.json.price?.toLocaleString() }}</p>\n  \n  <h3>Matched Leads ({{ $input.all().length }})</h3>\n  <ul>\n  {{ $input.all().map(l => '<li>' + l.json.lead_name + ' (' + l.json.lead_email + ')</li>').join('') }}\n  </ul>\n  \n  <p>Consider reaching out to these leads about the new listing!</p>\n</div>",
        "options": {}
      },
