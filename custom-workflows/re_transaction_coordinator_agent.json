      "parameters": {
        "jsCode": "// Build daily summary\nconst transactions = $('Filter Active Only').all();\nconst tasks = $input.all();\nconst now = new Date();\nconst today = now.toISOString().split('T')[0];\n\nlet summary = {\n  date: today,\n  active_transactions: transactions.length,\n  transactions: [],\n  overdue_tasks: 0,\n  due_today: 0,\n  due_this_week: 0\n};\n\nfor (const tx of transactions) {\n  const txId = tx.json['Transaction ID'];\n  const txTasks = tasks.filter(t => t.json['Transaction ID'] === txId && t.json.Status !== 'completed');\n  \n  const overdue = txTasks.filter(t => new Date(t.json['Due Date']) < now);\n  const dueToday = txTasks.filter(t => t.json['Due Date'] === today);\n  const dueThisWeek = txTasks.filter(t => {\n    const due = new Date(t.json['Due Date']);\n    const weekFromNow = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);\n    return due >= now && due <= weekFromNow;\n  });\n  \n  summary.overdue_tasks += overdue.length;\n  summary.due_today += dueToday.length;\n  summary.due_this_week += dueThisWeek.length;\n  \n  summary.transactions.push({\n    id: txId,\n    property: tx.json['Property Address'],\n    client: tx.json['Client Name'],\n    closing_date: tx.json['Closing Date'],\n    days_to_close: Math.ceil((new Date(tx.json['Closing Date']) - now) / (1000 * 60 * 60 * 24)),\n    pending_tasks: txTasks.length,\n    overdue: overdue.length,\n    high_priority: txTasks.filter(t => t.json.Priority === 'high').length\n  });\n}\n\n// Sort by days to close\nsummary.transactions.sort((a, b) => a.days_to_close - b.days_to_close);\n\nreturn [{ json: summary }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 600],
      "id": "build-summary",
      "name": "Build Daily Summary"
    },
    {
      "parameters": {
        "sendTo": "YOUR_AGENT_EMAIL",
        "subject": "=📋 Daily Transaction Summary - {{ $json.date }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 700px;\">\n  <h1>📋 Daily Transaction Summary</h1>\n  <p style=\"color: #666;\">{{ $json.date }}</p>\n  \n  <div style=\"display: flex; gap: 20px; margin: 20px 0;\">\n    <div style=\"background: #e3f2fd; padding: 15px; border-radius: 8px; text-align: center; flex: 1;\">\n      <h3 style=\"margin: 0; color: #1976d2;\">{{ $json.active_transactions }}</h3>\n      <p style=\"margin: 5px 0 0; font-size: 12px;\">Active Transactions</p>\n    </div>\n    <div style=\"background: {{ $json.overdue_tasks > 0 ? '#ffebee' : '#e8f5e9' }}; padding: 15px; border-radius: 8px; text-align: center; flex: 1;\">\n      <h3 style=\"margin: 0; color: {{ $json.overdue_tasks > 0 ? '#c62828' : '#2e7d32' }};\">{{ $json.overdue_tasks }}</h3>\n      <p style=\"margin: 5px 0 0; font-size: 12px;\">Overdue Tasks</p>\n    </div>\n    <div style=\"background: #fff3e0; padding: 15px; border-radius: 8px; text-align: center; flex: 1;\">\n      <h3 style=\"margin: 0; color: #ef6c00;\">{{ $json.due_today }}</h3>\n      <p style=\"margin: 5px 0 0; font-size: 12px;\">Due Today</p>\n    </div>\n    <div style=\"background: #f3e5f5; padding: 15px; border-radius: 8px; text-align: center; flex: 1;\">\n      <h3 style=\"margin: 0; color: #7b1fa2;\">{{ $json.due_this_week }}</h3>\n      <p style=\"margin: 5px 0 0; font-size: 12px;\">Due This Week</p>\n    </div>\n  </div>\n  \n  <h2>Transaction Pipeline</h2>\n  <table style=\"width: 100%; border-collapse: collapse;\">\n    <tr style=\"background: #f5f5f5;\">\n      <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Property</th>\n      <th style=\"padding: 10px; text-align: left; border: 1px solid #ddd;\">Client</th>\n      <th style=\"padding: 10px; text-align: center; border: 1px solid #ddd;\">Days to Close</th>\n      <th style=\"padding: 10px; text-align: center; border: 1px solid #ddd;\">Tasks</th>\n      <th style=\"padding: 10px; text-align: center; border: 1px solid #ddd;\">⚠️</th>\n    </tr>\n    {{ $json.transactions.map(t => '<tr><td style=\"padding: 10px; border: 1px solid #ddd;\">' + t.property + '</td><td style=\"padding: 10px; border: 1px solid #ddd;\">' + t.client + '</td><td style=\"padding: 10px; text-align: center; border: 1px solid #ddd;\">' + t.days_to_close + '</td><td style=\"padding: 10px; text-align: center; border: 1px solid #ddd;\">' + t.pending_tasks + '</td><td style=\"padding: 10px; text-align: center; border: 1px solid #ddd; color: ' + (t.overdue > 0 ? 'red' : 'green') + ';\">' + (t.overdue > 0 ? t.overdue : '✓') + '</td></tr>').join('') }}\n  </table>\n  \n  <p style=\"margin-top: 20px; color: #666; font-size: 12px;\">Generated by RE Transaction Coordinator Agent</p>\n</div>",
        "options": {}
