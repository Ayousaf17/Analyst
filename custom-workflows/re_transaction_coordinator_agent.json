      "parameters": {
        "jsCode": "// Filter for upcoming deadlines (within 48 hours) and overdue tasks\nconst now = new Date();\nconst in48Hours = new Date(now.getTime() + 48 * 60 * 60 * 1000);\n\nconst tasks = $input.all();\nconst alerts = [];\n\nfor (const task of tasks) {\n  if (task.json.Status === 'completed') continue;\n  \n  const dueDate = new Date(task.json['Due Date']);\n  \n  // Check if overdue\n  if (dueDate < now) {\n    alerts.push({\n      ...task.json,\n      alert_type: 'OVERDUE',\n      days_overdue: Math.floor((now - dueDate) / (1000 * 60 * 60 * 24)),\n      urgency: 'critical'\n    });\n  }\n  // Check if due within 48 hours\n  else if (dueDate <= in48Hours) {\n    alerts.push({\n      ...task.json,\n      alert_type: 'DUE_SOON',\n      hours_until_due: Math.floor((dueDate - now) / (1000 * 60 * 60)),\n      urgency: task.json.Priority === 'high' ? 'high' : 'medium'\n    });\n  }\n}\n\n// Sort by urgency\nalerts.sort((a, b) => {\n  const urgencyOrder = { critical: 0, high: 1, medium: 2 };\n  return urgencyOrder[a.urgency] - urgencyOrder[b.urgency];\n});\n\nreturn alerts.map(a => ({ json: a }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 400],
      "id": "filter-deadline-alerts",
      "name": "Filter Deadline Alerts"
    },
