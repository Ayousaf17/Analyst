        "sendTo": "YOUR_AGENT_EMAIL",
        "subject": "=⚠️ Deadline Alert: {{ $json.Task }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif;\">\n  <h2 style=\"color: {{ $json.urgency === 'critical' ? '#dc3545' : '#ffc107' }};\">{{ $json.alert_type === 'OVERDUE' ? '🚨 OVERDUE TASK' : '⚠️ UPCOMING DEADLINE' }}</h2>\n  \n  <table style=\"border-collapse: collapse; width: 100%;\">\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Transaction:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json['Transaction ID'] }}</td></tr>\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Task:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.Task }}</td></tr>\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Due Date:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json['Due Date'] }}</td></tr>\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Priority:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.Priority }}</td></tr>\n    <tr><td style=\"padding: 8px; border: 1px solid #ddd;\"><strong>Category:</strong></td><td style=\"padding: 8px; border: 1px solid #ddd;\">{{ $json.Category }}</td></tr>\n  </table>\n  \n  <p style=\"margin-top: 20px;\">{{ $json.alert_type === 'OVERDUE' ? 'This task is ' + $json.days_overdue + ' day(s) overdue!' : 'Due in ' + $json.hours_until_due + ' hours' }}</p>\n</div>",
