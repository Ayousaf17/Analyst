      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a real estate transaction coordinator assistant. Generate a JSON checklist of tasks for a new real estate transaction. Include typical milestones with due dates calculated from the contract date. Return ONLY valid JSON array.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate transaction checklist for:\\n- Type: {{ $('Normalize Transaction Data').item.json.transaction_type }}\\n- Contract Date: {{ $('Normalize Transaction Data').item.json.contract_date }}\\n- Option Period End: {{ $('Normalize Transaction Data').item.json.option_period_end }}\\n- Financing Deadline: {{ $('Normalize Transaction Data').item.json.financing_deadline }}\\n- Closing Date: {{ $('Normalize Transaction Data').item.json.closing_date }}\\n\\nReturn JSON array with: [{task, due_date, priority, category}]\"\n    }\n  ],\n  \"max_tokens\": 1000\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 100],
      "id": "generate-checklist",
      "name": "Generate Task Checklist",
      "credentials": {
        "httpHeaderAuth": {
          "id": "OPENROUTER_CREDENTIAL_ID",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and extract checklist\nconst response = $input.first().json;\nconst content = response.choices[0].message.content;\n\n// Extract JSON from response\nlet checklist = [];\ntry {\n  // Try to find JSON array in response\n  const jsonMatch = content.match(/\\[([\\s\\S]*?)\\]/);\n  if (jsonMatch) {\n    checklist = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  // Default checklist if parsing fails\n  const contractDate = new Date($('Normalize Transaction Data').item.json.contract_date);\n  checklist = [\n    { task: 'Send executed contract to all parties', due_date: contractDate.toISOString().split('T')[0], priority: 'high', category: 'documents' },\n    { task: 'Order title commitment', due_date: new Date(contractDate.getTime() + 3*24*60*60*1000).toISOString().split('T')[0], priority: 'high', category: 'title' },\n    { task: 'Schedule inspection', due_date: new Date(contractDate.getTime() + 5*24*60*60*1000).toISOString().split('T')[0], priority: 'high', category: 'inspection' },\n    { task: 'Verify earnest money deposit', due_date: new Date(contractDate.getTime() + 3*24*60*60*1000).toISOString().split('T')[0], priority: 'high', category: 'financial' },\n    { task: 'Follow up with lender on loan status', due_date: new Date(contractDate.getTime() + 7*24*60*60*1000).toISOString().split('T')[0], priority: 'medium', category: 'financing' },\n    { task: 'Schedule appraisal', due_date: new Date(contractDate.getTime() + 10*24*60*60*1000).toISOString().split('T')[0], priority: 'medium', category: 'financing' },\n    { task: 'Review title commitment', due_date: new Date(contractDate.getTime() + 14*24*60*60*1000).toISOString().split('T')[0], priority: 'medium', category: 'title' },\n    { task: 'Confirm clear to close', due_date: $('Normalize Transaction Data').item.json.closing_date, priority: 'high', category: 'closing' },\n    { task: 'Schedule final walkthrough', due_date: $('Normalize Transaction Data').item.json.closing_date, priority: 'high', category: 'closing' }\n  ];\n}\n\nconst txId = $('Normalize Transaction Data').item.json.transaction_id;\n\nreturn checklist.map((item, index) => ({\n  json: {\n    transaction_id: txId,\n    task_id: `${txId}-T${index + 1}`,\n    task: item.task,\n    due_date: item.due_date,\n    priority: item.priority,\n    category: item.category,\n    status: 'pending',\n    created_at: new Date().toISOString()\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 100],
      "id": "parse-checklist",
      "name": "Parse Checklist"
    },
