    {
      "parameters": {
        "content": "## Step 4: Render Video\nCreatomate assembles final video",
        "height": 80,
        "width": 400,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [2740, 100],
      "id": "sticky-step4",
      "name": "Step 4"
    },
    {
      "parameters": {
        "jsCode": "// Build Creatomate render payload\nconst scenes = $input.first().json.all_scenes;\nconst scriptData = $('Parse Script').first().json;\n\n// Calculate cumulative start times\nlet currentTime = 0;\nconst elements = [];\n\nscenes.forEach((scene, index) => {\n  // Image element\n  elements.push({\n    \"type\": \"image\",\n    \"track\": 1,\n    \"time\": currentTime,\n    \"duration\": scene.duration_seconds,\n    \"source\": scene.image_url,\n    \"fit\": \"cover\",\n    \"animations\": [\n      { \"type\": \"fade\", \"fade_type\": \"in\", \"duration\": 0.3 },\n      { \"type\": \"fade\", \"fade_type\": \"out\", \"duration\": 0.3, \"start_time\": scene.duration_seconds - 0.3 }\n    ]\n  });\n  \n  // Audio element\n  elements.push({\n    \"type\": \"audio\",\n    \"track\": 2,\n    \"time\": currentTime,\n    \"source\": scene.audio_url\n  });\n  \n  // Text overlay (if any)\n  if (scene.text_overlay) {\n    elements.push({\n      \"type\": \"text\",\n      \"track\": 3,\n      \"time\": currentTime + 0.5,\n      \"duration\": scene.duration_seconds - 1,\n      \"text\": scene.text_overlay,\n      \"font_family\": \"Permanent Marker\",\n      \"font_size\": \"8 vmin\",\n      \"fill_color\": \"#000000\",\n      \"x\": \"50%\",\n      \"y\": \"85%\",\n      \"x_anchor\": \"50%\",\n      \"y_anchor\": \"50%\",\n      \"animations\": [\n        { \"type\": \"fade\", \"fade_type\": \"in\", \"duration\": 0.3 }\n      ]\n    });\n  }\n  \n  currentTime += scene.duration_seconds;\n});\n\nreturn {\n  json: {\n    \"output_format\": \"mp4\",\n    \"width\": 1080,\n    \"height\": 1920,\n    \"frame_rate\": 30,\n    \"elements\": elements,\n    \"metadata\": {\n      \"title\": scriptData.title,\n      \"instagram_caption\": scriptData.instagram_caption,\n      \"hashtags\": scriptData.hashtags\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2780, 200],
      "id": "build-creatomate-payload",
      "name": "Build Creatomate Payload"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.creatomate.com/v1/renders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
